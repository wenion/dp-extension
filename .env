VITE_API_URL=http://127.0.0.1:3000

VERSION=5.4.2
EXTERNALLY_CONNECTABLE_MATCHES=http://127.0.0.1:3000/*
XHR_INTERCEPTOR_RESOURCES=xhr-interceptor.js
XHR_INTERCEPTOR_MATCHES=https://docs.google.com/*
FETCH_INTERCEPTOR_RESOURCES=fetch-interceptor.js
FETCH_INTERCEPTOR_MATCHES=https://chatgpt.com/*, https://claude.ai/*,
HOST_PERMISSIONS=<all_urls>
CONTENT_SCRIPT_MATCHES=<all_urls>
PERMISSIONS=contextMenus, storage, tabs, activeTab, webNavigation, identity, scripting
OPTIONAL_HOST_PERMISSIONS=https://*/*, http://*/*