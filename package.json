{
  "name": "dp-extension",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.dev.config.ts --mode content",
    "dev:content": "vite --config vite.dev.config.ts --mode content",
    "dev:options": "vite --config vite.dev.config.ts --mode options",
    "prebuild": "node scripts/gen-manifest-mustache.mjs",
    "build:options": "vite build --config vite.options.config.ts",
    "build:background": "vite build --config vite.background.config.ts",
    "build:content": "vite build --config vite.content.config.ts",
    "build": "tsc -b && npm run build:options && npm run build:background && npm run build:content",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@heroui/alert": "^2.2.32",
    "@heroui/button": "^2.2.32",
    "@heroui/card": "^2.2.28",
    "@heroui/chip": "^2.2.25",
    "@heroui/divider": "^2.2.24",
    "@heroui/input": "^2.4.33",
    "@heroui/link": "^2.2.26",
    "@heroui/switch": "^2.2.27",
    "@heroui/system": "^2.4.28",
    "@heroui/theme": "^2.4.26",
    "@heroui/toast": "^2.0.22",
    "@tailwindcss/vite": "^4.3.1",
    "dotenv": "^17.4.2",
    "idb": "^8.0.3",
    "mustache": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gravity-ui/icons": "^2.18.0",
    "@types/chrome": "^0.2.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
